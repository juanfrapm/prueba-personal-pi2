; =============================================================================
; PLANTILLA DE SECRETOS — este archivo SÍ se versiona, porque no tiene valores.
;
; Qué hacer:
;   1. Copialo:  cp secrets.ini.example secrets.ini
;   2. Completá los cuatro valores en secrets.ini (NO acá).
;   3. Nunca commitees secrets.ini. Está en .gitignore por algo.
;
; Si no lo copiás, no pasa nada: la primera compilación lo crea sola a partir
; de este archivo y te avisa por consola. Compila igual, pero no se va a poder
; conectar hasta que completes los valores.
;
; Si alguna vez commiteás un secreto por error: rotá el token en ThingsBoard.
; Borrarlo en el commit siguiente no lo saca del historial. Ver README.md.
; =============================================================================

[secrets]

; Nombre de tu red WiFi. Ojo: los ESP8266/ESP32 solo ven redes de 2,4 GHz.
wifi_ssid = TU_RED_WIFI

; Contraseña de esa red.
wifi_password = TU_PASSWORD_WIFI

; Host de la instancia de ThingsBoard, sin http:// y sin puerto.
; Te lo pasan en clase. Ejemplo de formato: thingsboard.ejemplo.edu.uy
tb_host = HOST_DE_THINGSBOARD

; Access token del dispositivo.
; ThingsBoard: Entidades -> Dispositivos -> tu dispositivo ->
; Administrar credenciales -> Access token.
tb_token = PEGAR_TOKEN_ACA
